[Unit]
Description=icecc-top node metrics agent
Documentation=https://github.com/gyuyoung/IceccTop
After=network.target
# Not a hard dependency: the agent is useful on any host, whether or not this
# machine also runs an Icecream daemon.
Wants=iceccd.service

[Service]
Type=exec
ExecStart=/usr/local/bin/icecc-top-agent
Restart=on-failure
RestartSec=5s

# The agent only reads /proc and /sys and serves them over one GET endpoint, so
# it needs no privileges, no persistent identity and no write access anywhere.
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# It is a monitoring agent; it must never compete with the compiler.
Nice=10
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
